APP_ENV=production
DOMAIN=voicerag.example.com
SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890
DATABASE_URL=postgresql+asyncpg://voicerag:voicerag@postgres:5432/voicerag
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
LLM_GATEWAY_MODEL=claude-sonnet-4-5-20250929
LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
VECTOR_BACKEND=qdrant
CHROMA_DIR=./data/chroma
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voice_transcripts
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500
MAX_AUDIO_DURATION_SECONDS=14400
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
AUTH_REQUIRED=false
ADMIN_EMAIL=admin@example.com
JWT_EXPIRE_MINUTES=15
REFRESH_COOKIE_NAME=__Host-voicerag-refresh
REFRESH_DAYS=30
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=voicerag
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_PRESIGN_SECONDS=900
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
RATE_LIMIT_PER_MINUTE=60
ANSWER_CACHE_TTL_SECONDS=60
ANSWER_CACHE_MAX_ENTRIES=512
QUERY_EMBEDDING_CACHE_MAX_ENTRIES=1024
EVALUATION_CONCURRENCY=4
RETRIEVAL_MAX_DISTANCE=0.72
MIN_CITATION_COVERAGE=0.75
